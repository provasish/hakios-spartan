# HakiOS fragment: the Qualcomm SM8250 family (SM8250, SM8250-AC: "kona") -- what is true of the SoC, whatever phone it is in.
# Eight cores, the biggest is core 7. The kernel's version names the SoC (hakios_kver ...-sm8250-...), which is how the framebuffer
# knows where this family's display interface is. The SC7280 family's drivers (cpufreq, thermal, socinfo, PMIC list) are NOT
# switched on here: they read and write that family's addresses. The Adreno 650's support is in the common GPU driver, chosen at
# run time on this SoC's phones.
CONFIG_SOC="sm8250"
CONFIG_CPUS=8
