# Spartan RAM-boot bring-up build. Each probe needs its own explicit boot argument.
#include spartan-gpu-probe.config
CONFIG_HAKIOS_BUTTONS=y
CONFIG_HAKIOS_UFS=y
# CPU clocks: SM8250 OSM layout in hakios.cpufreq.c; still needs boot-arg cpufreq=1
CONFIG_HAKIOS_CPUFREQ=y
# Wi-Fi: the QCA6390 on PCIe 0 (wifi=1), on the common Wi-Fi stack and its QMI
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_WIFI=y
CONFIG_HAKIOS_SPARTAN_WIFI=y
