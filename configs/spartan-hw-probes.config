# Spartan RAM-boot bring-up build. Each probe needs its own explicit boot argument.
#include spartan-gpu-probe.config
CONFIG_HAKIOS_BUTTONS=y
CONFIG_HAKIOS_UFS=y
# CPU clocks: SM8250 OSM layout in hakios.cpufreq.c; still needs boot-arg cpufreq=1
CONFIG_HAKIOS_CPUFREQ=y
# Wi-Fi: the QCA6390 on PCIe 0 (wifi=1), on the common Wi-Fi stack and its QMI
CONFIG_HAKIOS_QMI=y
CONFIG_HAKIOS_WIFI=y
CONFIG_HAKIOS_SPARTAN_WIFI=y
# This build loads firmware pulled from the phone (fw-gpu, fw-wifi): not the open profile
CONFIG_FIRMWARE="device"
CONFIG_WIFI=y
# the X55 modem on PCIe 2 (modem=N), on an MHI host; its firmware in the system image (MODEM=1, fw-modem/image)
CONFIG_HAKIOS_MHI=y
CONFIG_HAKIOS_SPARTAN_MODEM=y
# the battery's charge from the bq27541 fuel gauge (spartan_battery=1), read only, into the common battery power source
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_SPARTAN_BATTERY=y
